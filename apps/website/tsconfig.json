{
  "extends": "@bv/typescript-config/base.json",
  "compilerOptions": {
    /* Next.js Specific */
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@components/*": ["./app/components/*"],
      "@lib/*": ["./app/lib/*"],
      "sanity.types": ["./sanity.types.ts"]
    }
  },
  "include": ["image-modules.d.ts", "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
