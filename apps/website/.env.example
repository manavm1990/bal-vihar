NEXT_PUBLIC_SANITY_PROJECT_ID=x5wq3sbt
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Hosted Sanity Studio URL (from `sanity deploy`), used for click-to-edit links
NEXT_PUBLIC_SANITY_STUDIO_URL=https://YOUR_STUDIO_HOST.sanity.studio
# Required on the website host for draft preview (Viewer token in Sanity Manage → API → Tokens)
SANITY_API_READ_TOKEN=
# Algolia site search (server only; AOS nonprofit plan on app ZPACIX6ZZS). Search key is search-only; write key stays secret.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_WRITE_KEY=
ALGOLIA_INDEX_NAME=
# Shared secret for POST /api/search/reindex (deploy hook and Sanity webhook send it as a Bearer token).
# After changing index settings/synonyms, call with ?configure=true&wait=true once.
SEARCH_REINDEX_SECRET=
# Secret for POST /api/revalidate; paste the same value into the Sanity webhook's Secret field
SANITY_REVALIDATE_SECRET=
