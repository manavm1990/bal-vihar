{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "deploy": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^transit"]
    },
    "typegen": {
      "cache": false,
      "outputs": ["schema.json", "../website/sanity.types.ts"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  },
  "globalPassThroughEnv": [
    "ALGOLIA_APP_ID",
    "ALGOLIA_INDEX_NAME",
    "ALGOLIA_SEARCH_KEY",
    "ALGOLIA_WRITE_KEY",
    "SEARCH_REINDEX_SECRET",
    "NEXT_PUBLIC_SANITY_PROJECT_ID",
    "NEXT_PUBLIC_SANITY_DATASET",
    "NEXT_PUBLIC_SANITY_API_VERSION",
    "NEXT_PUBLIC_SANITY_STUDIO_URL",
    "SANITY_API_READ_TOKEN",
    "SANITY_REVALIDATE_SECRET",
    "SANITY_STUDIO_PREVIEW_ORIGIN"
  ]
}
