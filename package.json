{
  "name": "bal-vihar-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy:studio": "turbo run deploy --filter=@bv/studio",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen --filter=@bv/studio",
    "prepare": "husky",
    "postinstall": "bunx skills update -p -y || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "baseline-browser-mapping": "^2.11.33",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "skills": "^1.7.4",
    "turbo": "^2.11.10"
  },
  "overrides": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
