{
  "name": "bal-vihar-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy:studio": "turbo run deploy --filter=@bv/studio",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen --filter=@bv/studio",
    "prepare": "husky",
    "postinstall": "npx skills update -p -y || echo 'skills update skipped'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "baseline-browser-mapping": "^2.11.39",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "skills": "^1.9.0",
    "turbo": "^2.11.13"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
