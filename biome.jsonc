{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["./base.jsonc"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.agents",
      "!.claude",
      "!dist",
      "!build",
      "!**/sanity.types.ts",
      "!**/schema.json"
    ]
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "turborepo": "all",
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noVar": "error"
      },
      "style": {
        "useConst": "error",
        "useSingleVarDeclarator": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "conventions": [
              {
                "selector": {
                  "kind": "const"
                },
                "match": "[A-Z][a-zA-Z0-9]*Schema|(.+)"
              },
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "function"
                },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeLike"
                },
                "formats": ["PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "const",
                  "scope": "global"
                },
                "formats": ["CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "classProperty",
                  "modifiers": ["static", "readonly"]
                },
                "formats": ["CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "classMember",
                  "modifiers": ["private"]
                },
                "match": "_(.+)"
              },
              {
                "selector": {
                  "kind": "classMember",
                  "modifiers": ["private"]
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                // Sanity's system fields (`_type`, `_key`, `_ref`…) keep their API names.
                "match": "_(?:createdAt|id|key|ref|rev|type|updatedAt|weak)|(.+)",
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase", "snake_case"]
              }
            ]
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "correctness": {
        "noInnerDeclarations": "error"
      }
    }
  },
  "json": {
    "parser": {
      // tsconfig-style files (e.g. packages/typescript-config/base.json) are JSONC
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
